Count_op=0
def find_min(numbers):
    min=numbers[0]
    for x in range(len(numbers)):
        if numbers[x]<min:
            min=numbers[x]
    global Count_op
    Count_op+=1
    return min

def find_max(numbers):
    max=numbers[0]
    for i in range(len(numbers)):
        if numbers[i]>max:
            max=numbers[i]
    global Count_op
    Count_op+=1
    return max
def calculate_sum(numbers):
    s=0
    for x in range(len(numbers)):
        s+=numbers[x]
    global Count_op
    Count_op+=1
    return s

def find_value(numbers, target):
    for x in range(len(numbers)):
        if numbers[x]==target:
            global Count_op
            Count_op+=1
            return x
    Count_op+=1
    return "нет такой циферки"
def calculate_average(numbers):
    global Count_op
    Count_op+=1
    return calculate_sum(numbers)/len(numbers)
    
def count_above_average(numbers):
    n=0
    y=calculate_average(numbers)
    for x in range(len(numbers)):
        if numbers[x]>y:
            n+=1
    global Count_op
    Count_op+=1
    return n


def analyze_measurements(numbers):
    global Count_op
    Count_op+=1
    return (find_min(numbers),find_max(numbers),calculate_average(numbers))

